CREATE TABLE save_run (
    run_id TEXT NOT NULL PRIMARY KEY,
    world_definition_id TEXT NOT NULL,
    data_schema_version INTEGER NOT NULL DEFAULT 1,
    world_content_version INTEGER NOT NULL DEFAULT 1,
    display_name TEXT NOT NULL DEFAULT '',
    archived INTEGER NOT NULL DEFAULT 0,
    last_persisted_event_sequence INTEGER NOT NULL DEFAULT 0,
    last_persisted_turn_id TEXT,
    save_status TEXT NOT NULL DEFAULT 'SAVED',
    saved_at_epoch_millis INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE event_log (
    run_id TEXT NOT NULL,
    sequence INTEGER NOT NULL,
    event_id TEXT NOT NULL UNIQUE,
    event_json TEXT NOT NULL,
    event_schema_version INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (run_id, sequence),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE state_snapshot (
    run_id TEXT NOT NULL PRIMARY KEY,
    sequence INTEGER NOT NULL,
    state_schema_version INTEGER NOT NULL,
    state_json TEXT NOT NULL,
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE character_creation_draft (
    run_id TEXT NOT NULL PRIMARY KEY,
    draft_schema_version INTEGER NOT NULL,
    draft_json TEXT NOT NULL,
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE gm_turn (
    run_id TEXT NOT NULL,
    turn_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    turn_schema_version INTEGER NOT NULL,
    turn_json TEXT NOT NULL,
    turn_ordinal INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (run_id, turn_id),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX gm_turn_run_ordinal ON gm_turn(run_id, turn_ordinal);

CREATE TABLE behavior_work (
    run_id TEXT NOT NULL,
    work_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    parent_sequence INTEGER NOT NULL,
    status TEXT NOT NULL,
    work_json TEXT NOT NULL,
    PRIMARY KEY (run_id, work_id),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE npc_work (
    run_id TEXT NOT NULL,
    work_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    source_sequence INTEGER NOT NULL,
    status TEXT NOT NULL,
    work_json TEXT NOT NULL,
    PRIMARY KEY (run_id, work_id),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE agent_session (
    run_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    owner_agent_id TEXT NOT NULL,
    owner_actor_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    messages_json TEXT NOT NULL,
    session_schema_version INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (run_id, session_id),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);


CREATE TABLE agent_turn (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    sequence INTEGER NOT NULL,
    session_id TEXT NOT NULL,
    input_text TEXT NOT NULL,
    output_text TEXT NOT NULL,
    token_count INTEGER NOT NULL,
    source_event_ids_json TEXT NOT NULL,
    PRIMARY KEY (run_id, agent_id, sequence),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE agent_memory (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    memory_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    content TEXT NOT NULL,
    salience REAL NOT NULL,
    confidence REAL NOT NULL,
    tags_json TEXT NOT NULL,
    related_entity_ids_json TEXT NOT NULL,
    protected INTEGER NOT NULL,
    created_sequence INTEGER NOT NULL,
    last_accessed_sequence INTEGER NOT NULL,
    data_version INTEGER NOT NULL,
    PRIMARY KEY (run_id, agent_id, memory_id),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE agent_belief (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    memory_id TEXT NOT NULL,
    PRIMARY KEY (run_id, agent_id, memory_id),
    FOREIGN KEY (run_id, agent_id, memory_id)
        REFERENCES agent_memory(run_id, agent_id, memory_id) ON DELETE CASCADE
);

CREATE TABLE agent_goal (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    memory_id TEXT NOT NULL,
    PRIMARY KEY (run_id, agent_id, memory_id),
    FOREIGN KEY (run_id, agent_id, memory_id)
        REFERENCES agent_memory(run_id, agent_id, memory_id) ON DELETE CASCADE
);

CREATE TABLE relationship_state (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    memory_id TEXT NOT NULL,
    PRIMARY KEY (run_id, agent_id, memory_id),
    FOREIGN KEY (run_id, agent_id, memory_id)
        REFERENCES agent_memory(run_id, agent_id, memory_id) ON DELETE CASCADE
);

CREATE TABLE context_checkpoint (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    idempotency_key TEXT NOT NULL,
    from_sequence INTEGER NOT NULL,
    to_sequence INTEGER NOT NULL,
    prompt_version INTEGER NOT NULL,
    model_id TEXT NOT NULL,
    summary TEXT NOT NULL,
    source_event_ids_json TEXT NOT NULL,
    published_at_epoch_millis INTEGER NOT NULL,
    PRIMARY KEY (run_id, agent_id, idempotency_key),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);

CREATE TABLE memory_event_link (
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    record_id TEXT NOT NULL,
    event_id TEXT NOT NULL,
    record_kind TEXT NOT NULL,
    PRIMARY KEY (run_id, agent_id, record_id, event_id, record_kind),
    FOREIGN KEY (run_id) REFERENCES save_run(run_id) ON DELETE CASCADE
);


CREATE TABLE provider_configuration (
    configuration_id TEXT NOT NULL PRIMARY KEY,
    adapter_id TEXT NOT NULL,
    display_name TEXT NOT NULL,
    base_url TEXT NOT NULL,
    model_id TEXT NOT NULL,
    credential_key TEXT NOT NULL,
    max_output_tokens INTEGER NOT NULL,
    input_cost_microunits_per_million_tokens INTEGER NOT NULL,
    output_cost_microunits_per_million_tokens INTEGER NOT NULL,
    allow_insecure_local_transport INTEGER NOT NULL
);

CREATE TABLE provider_settings (
    settings_id INTEGER NOT NULL PRIMARY KEY CHECK (settings_id = 1),
    selected_configuration_id TEXT,
    FOREIGN KEY (selected_configuration_id)
        REFERENCES provider_configuration(configuration_id) ON DELETE SET NULL
);

CREATE TABLE content_recognition_job (
    job_id TEXT NOT NULL PRIMARY KEY,
    schema_version INTEGER NOT NULL,
    revision INTEGER NOT NULL,
    source_name TEXT NOT NULL,
    source_format TEXT NOT NULL,
    source_hash TEXT NOT NULL,
    stage TEXT NOT NULL,
    status TEXT NOT NULL,
    job_json TEXT NOT NULL
);

insertRun:
INSERT INTO save_run(run_id, world_definition_id, data_schema_version)
VALUES (?, ?, ?);

selectRun:
SELECT run_id, world_definition_id, data_schema_version, world_content_version, display_name, archived,
       last_persisted_event_sequence, last_persisted_turn_id, save_status, saved_at_epoch_millis
FROM save_run
WHERE run_id = ?;

insertRecognitionJob:
INSERT INTO content_recognition_job(
    job_id, schema_version, revision, source_name, source_format, source_hash, stage, status, job_json
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRecognitionJob:
SELECT job_id, schema_version, revision, source_name, source_format, source_hash, stage, status, job_json
FROM content_recognition_job
WHERE job_id = ?;

selectRecognitionJobs:
SELECT job_id, schema_version, revision, source_name, source_format, source_hash, stage, status, job_json
FROM content_recognition_job
ORDER BY job_id;

updateRecognitionJob:
UPDATE content_recognition_job
SET schema_version = ?, revision = ?, source_name = ?, source_format = ?, source_hash = ?,
    stage = ?, status = ?, job_json = ?
WHERE job_id = ? AND revision = ?;

selectAllRuns:
SELECT run_id, world_definition_id, data_schema_version, world_content_version, display_name, archived,
       last_persisted_event_sequence, last_persisted_turn_id, save_status, saved_at_epoch_millis
FROM save_run
ORDER BY run_id;

selectRunDirectory:
SELECT r.run_id, r.world_definition_id, r.data_schema_version, r.world_content_version,
       r.display_name, r.archived, COALESCE(MAX(e.sequence), 0) AS last_sequence,
       r.last_persisted_event_sequence, r.last_persisted_turn_id, r.save_status,
       r.saved_at_epoch_millis
FROM save_run r
LEFT JOIN event_log e ON e.run_id = r.run_id
GROUP BY r.run_id, r.world_definition_id, r.data_schema_version, r.world_content_version,
         r.display_name, r.archived, r.last_persisted_event_sequence, r.last_persisted_turn_id,
         r.save_status, r.saved_at_epoch_millis
ORDER BY r.run_id DESC;

selectLatestRunTurnId:
SELECT turn_id
FROM gm_turn
WHERE run_id = ?
ORDER BY turn_ordinal DESC
LIMIT 1;

markRunEventWriting:
UPDATE save_run
SET save_status = CASE WHEN save_status = 'WRITING_TURN' THEN save_status ELSE 'WRITING_EVENT' END
WHERE run_id = ?;

markRunEventPersisted:
UPDATE save_run
SET last_persisted_event_sequence = ?,
    save_status = CASE WHEN save_status = 'WRITING_TURN' THEN save_status ELSE 'SAVED' END,
    saved_at_epoch_millis = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER)
WHERE run_id = ?;

markRunTurnWriting:
UPDATE save_run
SET save_status = 'WRITING_TURN'
WHERE run_id = ?;

markRunTurnPersisted:
UPDATE save_run
SET last_persisted_event_sequence = (SELECT COALESCE(MAX(sequence), 0) FROM event_log WHERE run_id = save_run.run_id),
    last_persisted_turn_id = ?,
    save_status = 'SAVED',
    saved_at_epoch_millis = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER)
WHERE run_id = ?;

repairRunPersistenceEvidence:
UPDATE save_run
SET last_persisted_event_sequence = (SELECT COALESCE(MAX(sequence), 0) FROM event_log WHERE run_id = save_run.run_id),
    last_persisted_turn_id = (SELECT turn_id FROM gm_turn WHERE run_id = save_run.run_id ORDER BY turn_ordinal DESC LIMIT 1),
    save_status = 'SAVED',
    saved_at_epoch_millis = CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER)
WHERE run_id = ?;

renameRun:
UPDATE save_run SET display_name = ? WHERE run_id = ?;

setRunArchived:
UPDATE save_run SET archived = ? WHERE run_id = ?;

setRunContentVersion:
UPDATE save_run SET world_content_version = ? WHERE run_id = ?;

currentSequence:
SELECT COALESCE(MAX(sequence), 0)
FROM event_log
WHERE run_id = ?;

insertEvent:
INSERT INTO event_log(run_id, sequence, event_id, event_schema_version, event_json)
VALUES (?, ?, ?, ?, ?);

selectEventsAfter:
SELECT event_json
FROM event_log
WHERE run_id = ? AND sequence > ?
ORDER BY sequence;

upsertSnapshot:
INSERT OR REPLACE INTO state_snapshot(run_id, sequence, state_schema_version, state_json)
VALUES (?, ?, ?, ?);

selectSnapshot:
SELECT run_id, sequence, state_schema_version, state_json
FROM state_snapshot
WHERE run_id = ?;

upsertCharacterCreationDraft:
INSERT OR REPLACE INTO character_creation_draft(run_id, draft_schema_version, draft_json)
VALUES (?, ?, ?);

selectCharacterCreationDraft:
SELECT draft_schema_version, draft_json
FROM character_creation_draft
WHERE run_id = ?;

deleteCharacterCreationDraft:
DELETE FROM character_creation_draft WHERE run_id = ?;

selectGmTurn:
SELECT turn_ordinal, revision, turn_schema_version, turn_json
FROM gm_turn
WHERE run_id = ? AND turn_id = ?;

selectLatestGmTurnOrdinal:
SELECT COALESCE(MAX(turn_ordinal), 0)
FROM gm_turn
WHERE run_id = ?;

selectGmTurnPage:
SELECT turn_id, turn_ordinal, revision, turn_schema_version, turn_json
FROM gm_turn
WHERE run_id = ? AND turn_ordinal < ?
ORDER BY turn_ordinal DESC, turn_id DESC
LIMIT ?;

countGmTurnsBefore:
SELECT count(*)
FROM gm_turn
WHERE run_id = ? AND turn_ordinal < ?;

upsertGmTurn:
INSERT OR REPLACE INTO gm_turn(run_id, turn_id, turn_ordinal, revision, turn_schema_version, turn_json)
VALUES (?, ?, ?, ?, ?, ?);

selectBehaviorWork:
SELECT work_json
FROM behavior_work
WHERE run_id = ? AND work_id = ?;

selectBehaviorWorks:
SELECT work_json
FROM behavior_work
WHERE run_id = ?
ORDER BY parent_sequence, work_id;

insertBehaviorWork:
INSERT OR IGNORE INTO behavior_work(run_id, work_id, revision, parent_sequence, status, work_json)
VALUES (?, ?, ?, ?, ?, ?);

updateBehaviorWork:
UPDATE behavior_work
SET revision = ?, parent_sequence = ?, status = ?, work_json = ?
WHERE run_id = ? AND work_id = ? AND revision = ?;

selectNpcWork:
SELECT work_json
FROM npc_work
WHERE run_id = ? AND work_id = ?;

selectNpcWorks:
SELECT work_json
FROM npc_work
WHERE run_id = ?
ORDER BY source_sequence, work_id;

insertNpcWork:
INSERT INTO npc_work(run_id, work_id, revision, source_sequence, status, work_json)
VALUES (?, ?, ?, ?, ?, ?);

updateNpcWork:
UPDATE npc_work
SET revision = ?, status = ?, work_json = ?
WHERE run_id = ? AND work_id = ? AND revision = ?;

selectAgentSession:
SELECT session_id, owner_agent_id, owner_actor_id, revision, messages_json, session_schema_version
FROM agent_session
WHERE run_id = ? AND session_id = ?;

insertAgentSession:
INSERT INTO agent_session(
    run_id,
    session_id,
    owner_agent_id,
    owner_actor_id,
    revision,
    messages_json,
    session_schema_version
)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateAgentSession:
UPDATE agent_session
SET revision = ?, messages_json = ?, session_schema_version = ?
WHERE run_id = ? AND session_id = ? AND revision = ?;


insertAgentTurn:
INSERT INTO agent_turn(
    run_id, agent_id, sequence, session_id, input_text, output_text, token_count, source_event_ids_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAgentTurns:
SELECT agent_id, sequence, session_id, input_text, output_text, token_count, source_event_ids_json
FROM agent_turn
WHERE run_id = ? AND agent_id = ? AND sequence > ? AND sequence <= ?
ORDER BY sequence;

selectAgentMemory:
SELECT kind
FROM agent_memory
WHERE run_id = ? AND agent_id = ? AND memory_id = ?;

upsertAgentMemory:
INSERT OR REPLACE INTO agent_memory(
    run_id, agent_id, memory_id, kind, content, salience, confidence, tags_json,
    related_entity_ids_json, protected, created_sequence, last_accessed_sequence, data_version
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAgentMemories:
SELECT memory_id, kind, content, salience, confidence, tags_json, related_entity_ids_json,
       protected, created_sequence, last_accessed_sequence, data_version
FROM agent_memory
WHERE run_id = ? AND agent_id = ?
ORDER BY memory_id;

insertAgentBelief:
INSERT OR IGNORE INTO agent_belief(run_id, agent_id, memory_id) VALUES (?, ?, ?);

insertAgentGoal:
INSERT OR IGNORE INTO agent_goal(run_id, agent_id, memory_id) VALUES (?, ?, ?);

insertRelationshipState:
INSERT OR IGNORE INTO relationship_state(run_id, agent_id, memory_id) VALUES (?, ?, ?);

selectCheckpointByKey:
SELECT idempotency_key
FROM context_checkpoint
WHERE run_id = ? AND agent_id = ? AND idempotency_key = ?;

selectLatestContextCheckpoint:
SELECT idempotency_key, from_sequence, to_sequence, prompt_version, model_id, summary,
       source_event_ids_json, published_at_epoch_millis
FROM context_checkpoint
WHERE run_id = ? AND agent_id = ?
ORDER BY to_sequence DESC
LIMIT 1;

insertContextCheckpoint:
INSERT INTO context_checkpoint(
    run_id, agent_id, idempotency_key, from_sequence, to_sequence, prompt_version, model_id,
    summary, source_event_ids_json, published_at_epoch_millis
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteMemoryEventLinks:
DELETE FROM memory_event_link
WHERE run_id = ? AND agent_id = ? AND record_id = ? AND record_kind = ?;

insertMemoryEventLink:
INSERT OR IGNORE INTO memory_event_link(run_id, agent_id, record_id, event_id, record_kind)
VALUES (?, ?, ?, ?, ?);

selectMemoryEventLinks:
SELECT event_id
FROM memory_event_link
WHERE run_id = ? AND agent_id = ? AND record_id = ? AND record_kind = ?
ORDER BY event_id;

countAgentTurnsInRange:
SELECT COUNT(*)
FROM agent_turn
WHERE run_id = ? AND agent_id = ? AND sequence >= ? AND sequence <= ?;


ensureProviderSettings:
INSERT OR IGNORE INTO provider_settings(settings_id, selected_configuration_id) VALUES (1, NULL);

selectProviderConfigurations:
SELECT configuration_id, adapter_id, display_name, base_url, model_id, credential_key,
       max_output_tokens, input_cost_microunits_per_million_tokens,
       output_cost_microunits_per_million_tokens, allow_insecure_local_transport
FROM provider_configuration
ORDER BY configuration_id;

selectProviderConfiguration:
SELECT configuration_id, adapter_id, display_name, base_url, model_id, credential_key,
       max_output_tokens, input_cost_microunits_per_million_tokens,
       output_cost_microunits_per_million_tokens, allow_insecure_local_transport
FROM provider_configuration
WHERE configuration_id = ?;

insertProviderConfiguration:
INSERT INTO provider_configuration(
    configuration_id, adapter_id, display_name, base_url, model_id, credential_key,
    max_output_tokens, input_cost_microunits_per_million_tokens,
    output_cost_microunits_per_million_tokens, allow_insecure_local_transport
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProviderConfiguration:
UPDATE provider_configuration
SET adapter_id = ?, display_name = ?, base_url = ?, model_id = ?, credential_key = ?,
    max_output_tokens = ?, input_cost_microunits_per_million_tokens = ?,
    output_cost_microunits_per_million_tokens = ?, allow_insecure_local_transport = ?
WHERE configuration_id = ?;

deleteProviderConfiguration:
DELETE FROM provider_configuration WHERE configuration_id = ?;

selectSelectedProviderConfiguration:
SELECT selected_configuration_id FROM provider_settings WHERE settings_id = 1;

updateSelectedProviderConfiguration:
UPDATE provider_settings SET selected_configuration_id = ? WHERE settings_id = 1;
