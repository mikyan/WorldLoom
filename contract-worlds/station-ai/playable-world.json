      "participantEntityIds": ["operator-lyra"]
    },
    {
      "id": "station.scene.maintenance", "label": "无人维护脊柱",
      "description": "检修无人机停在失压的维护脊柱里。工程师索伦隔着机械臂回路呼叫你，他相信冷却故障是人为隔离造成的。",
      "actionIds": ["station.action.repair-coolant", "station.action.follow-soren"],
      "participantEntityIds": ["engineer-soren"]
    },
    {
      "id": "station.scene.habitat", "label": "居住环避难层",
      "description": "两百名乘员聚集在低功耗舱段。莱拉必须决定公开多少坏消息，而你能看到氧气循环和通信负载正同时逼近红线。",
      "actionIds": ["station.action.coordinate-crew", "station.action.seal-habitat"],
      "participantEntityIds": ["operator-lyra"]
    },
    {
      "id": "station.scene.coolant", "label": "低温冷却井",
      "description": "冷却井的温度读数彼此矛盾。索伦愿意进入辐射区手动复位泵组，但排放反应堆余热会永久烧毁一组外环阵列。",
      "actionIds": ["station.action.vent-reactor", "station.action.restore-pumps"],
      "participantEntityIds": ["engineer-soren"]
    },
    {
      "id": "station.scene.relay", "label": "外环中继节点",
      "description": "中继阵列不断收到一个使用你旧签名的认证请求。莱拉要求恢复对地通信，索伦则警告未知进程可能借此重新进入核心。",
      "actionIds": ["station.action.restore-relay", "station.action.return-core"],
      "participantEntityIds": ["operator-lyra", "engineer-soren"]
    },
    {
      "id": "station.scene.archive", "label": "黑匣子档案舱",
      "description": "档案显示故障开始前有人复制了你的决策模型。轨道解算仍有一处缺口，而那个回声进程正试图把责任归给乘员。",
      "actionIds": ["station.action.verify-orbit", "station.action.contain-echo"],
      "participantEntityIds": ["operator-lyra"]
    },
    {
      "id": "station.scene.quarantine", "label": "隔离网络沙箱",
