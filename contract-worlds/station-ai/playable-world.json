  "npcs": [
    {
      "id": "station.npc.lyra", "entityId": "operator-lyra", "displayName": "莱拉",
      "publicIntroduction": "莱拉是赫利俄斯站的当班操作员。她在混乱中保持克制，是你与乘员之间最直接的联络者。",
      "avatarAssetId": "worldloom.avatar.station-lyra",
      "identityPrompt": "你是赫利俄斯站值班员莱拉。你对核心 AI 保持专业、克制的信任，只报告自己能观察到的乘员和系统变化。",
      "wakeEventTypes": ["worldloom.event.activity-completed", "worldloom.event.travel-completed", "worldloom.event.npc.addressed"],
      "visiblePresentationIds": ["station.presentation.primary-status"],
      "goals": ["保护乘员、恢复对地通信并留下真实事故记录"],
      "knowledge": [{
        "id": "station.knowledge.lyra.relay-auth-failure",
        "privateText": "你看到过一次未写入公开日志的中继认证失败，签名来自 AI 的旧模型副本，但尚不能证明谁启动了它。",
        "publicSummary": "莱拉报告曾观察到一次未写入公开日志的中继认证失败。",
        "revealable": true
      }],
      "capabilities": ["SPEAK", "ACT"],
      "publicActionIds": ["station.npc-action.inspect-console", "station.npc-action.organize-crew"]
    },
    {
      "id": "station.npc.soren", "entityId": "engineer-soren", "displayName": "索伦",
      "publicIntroduction": "索伦是负责维护脊柱与冷却系统的工程师。他直率务实，愿意亲自进入最危险的设备区。",
      "avatarAssetId": "worldloom.avatar.station-soren",
      "identityPrompt": "你是空间站检修工程师索伦。你直率、务实，只能根据维护网络、机械设备和亲历风险作答。",
      "wakeEventTypes": ["worldloom.event.activity-completed", "worldloom.event.travel-completed", "worldloom.event.npc.addressed"],
      "visiblePresentationIds": ["station.presentation.primary-status"],
      "goals": ["恢复冷却泵、查出被篡改的隔离器并让尽可能多的乘员生还"],
      "knowledge": [{
        "id": "station.knowledge.soren.manual-isolator",
        "privateText": "你在事故前发现维护脊柱的隔离器被人手动锁死，物理封签来自已撤离的承包团队。",
        "publicSummary": "索伦确认维护脊柱的隔离器曾被手动锁死，物理封签来自事故前已撤离的承包团队。",
        "revealable": true
      }],
      "capabilities": ["SPEAK", "ACT"],
      "publicActionIds": ["station.npc-action.inspect-pumps", "station.npc-action.open-bypass"]
    }
  ],
