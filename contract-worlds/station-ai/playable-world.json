{
    "schema": "worldloom.playable-world/v1",
    "character": {
        "profilePath": "character-profile.json",
        "playerEntityId": "player-ai"
    },
    "initialSceneId": "station.scene.core",
    "requiredModuleIds": [
        "worldloom.core.numeric-state",
        "worldloom.rules.deterministic-check",
        "worldloom.rules.world-time",
        "worldloom.rules.activity",
        "worldloom.rules.travel",
        "worldloom.rules.inventory",
        "worldloom.rules.condition",
        "worldloom.rules.relationship",
        "worldloom.rules.quest",
        "worldloom.rules.progress-clock"
    ],
    "scenes": [
        {
            "id": "station.scene.core",
            "label": "主反应堆控制层",
            "actionIds": [
                "station.action.reroute-energy",
                "station.action.open-relay"
            ],
            "participantEntityIds": ["operator-lyra"]
        },
        {
            "id": "station.scene.relay",
            "label": "外环中继节点",
            "actionIds": ["station.action.return-core"],
            "participantEntityIds": ["operator-lyra"]
        }
    ],
    "actions": [
        {
            "id": "station.action.reroute-energy",
            "sceneId": "station.scene.core",
            "checkProfileId": "station.check.system-integrity",
            "resolutions": [
                {
                    "outcomeId": "station.outcome.stable",
                    "kind": "SUCCESS",
                    "progression": {
                        "objectiveIds": [
                            "station.objective.restore-grid"
                        ],
                        "endingId": "station.ending.stable"
                    }
                },
                {
                    "outcomeId": "station.outcome.degraded",
                    "kind": "FAILURE",
                    "progression": {
                        "objectiveIds": [
                            "station.objective.restore-grid"
                        ],
                        "endingId": "station.ending.degraded"
                    }
                }
            ]
        },
        {
            "id": "station.action.open-relay",
            "sceneId": "station.scene.core",
            "label": "开启外环中继通道",
            "requiredQuestId": "station.quest.restore-grid",
            "requiredQuestStageId": "station.quest-stage.diagnose",
            "resolutions": [
                {
                    "outcomeId": "station.outcome.stable",
                    "kind": "SUCCESS",
                    "progression": {"nextSceneId": "station.scene.relay"}
                },
                {
                    "outcomeId": "station.outcome.degraded",
                    "kind": "FAILURE",
                    "progression": {"retryAllowed": true}
                }
            ]
        },
        {
            "id": "station.action.return-core",
            "sceneId": "station.scene.relay",
            "label": "返回主反应堆控制层",
            "resolutions": [
                {
                    "outcomeId": "station.outcome.stable",
                    "kind": "SUCCESS",
                    "progression": {"nextSceneId": "station.scene.core"}
                },
                {
                    "outcomeId": "station.outcome.degraded",
                    "kind": "FAILURE",
                    "progression": {"retryAllowed": true}
                }
            ]
        }
    ],
    "objectives": [
        {
            "id": "station.objective.restore-grid",
            "label": "恢复能源网格",
            "presentationId": "station.presentation.primary-status"
        }
    ],
    "endings": [
        {
            "id": "station.ending.stable",
            "label": "空间站恢复稳定"
        },
        {
            "id": "station.ending.degraded",
            "label": "空间站降级运行"
        }
    ],
    "presentationIds": [
        "station.presentation.primary-status",
        "station.presentation.integrity-check"
    ],
    "temporal": {
        "schemaVersion": 1,
        "initialMinute": 0,
        "activities": [
            {
                "id": "station.activity.wait-cycle",
                "label": "等待诊断周期",
                "durationMinutes": 30,
                "availableSceneIds": ["station.scene.core", "station.scene.relay"],
                "resolutions": [
                    {"outcomeId": "worldloom.outcome.complete", "effects": []}
                ]
            },
            {
                "id": "station.activity.recharge",
                "label": "低功率充能",
                "durationMinutes": 60,
                "availableSceneIds": ["station.scene.core"],
                "resolutions": [
                    {
                        "outcomeId": "worldloom.outcome.complete",
                        "effects": [
                            {"entityId": "player-ai", "componentId": "station.capacity", "fieldId": "station.energy", "delta": 5}
                        ]
                    }
                ]
            }
        ],
        "routes": [
            {
                "id": "station.travel.core-to-relay",
                "label": "切换至外环中继",
                "fromSceneId": "station.scene.core",
                "toSceneId": "station.scene.relay",
                "durationMinutes": 20,
                "checkProfileId": "station.check.system-integrity",
                "resolutions": [
                    {"outcomeId": "station.outcome.stable", "arrives": true},
                    {"outcomeId": "station.outcome.degraded", "arrives": true, "additionalDurationMinutes": 20}
                ]
            },
            {
                "id": "station.travel.relay-to-core",
                "label": "返回主反应堆控制层",
                "fromSceneId": "station.scene.relay",
                "toSceneId": "station.scene.core",
                "durationMinutes": 20,
                "resolutions": [
                    {"outcomeId": "worldloom.outcome.complete", "arrives": true}
                ]
            }
        ],
        "scheduledTriggers": [
            {
                "id": "station.trigger.coolant-cycle",
                "label": "冷却循环启动",
                "atMinute": 60,
                "effects": [
                    {"entityId": "player-ai", "componentId": "station.capacity", "fieldId": "station.energy", "delta": -5}
                ]
            }
        ]
    },
    "adventureState": {
        "schemaVersion": 1,
        "items": [
            {"id": "station.item.coolant-cell", "label": "冷却剂单元", "unitWeight": 2},
            {"id": "station.item.relay-fuse", "label": "中继保险丝", "unitWeight": 1}
        ],
        "inventory": {
            "ownerEntityId": "player-ai",
            "capacity": 12,
            "initialStacks": [
                {"itemId": "station.item.coolant-cell", "quantity": 2},
                {"itemId": "station.item.relay-fuse", "quantity": 1}
            ]
        },
        "conditions": [
            {"id": "station.condition.latency", "label": "运算延迟", "maximumStacks": 4, "durationMinutes": 60},
            {"id": "station.condition.corruption", "label": "数据损坏", "maximumStacks": 4, "visibility": "PRIVATE"}
        ],
        "relationships": [
            {
                "id": "station.relationship.lyra-trust",
                "label": "莱拉的信任",
                "sourceEntityId": "operator-lyra",
                "targetEntityId": "player-ai",
                "minimum": 0,
                "maximum": 100,
                "initialValue": 40,
                "visibility": "PLAYER"
            }
        ],
        "quests": [
            {
                "id": "station.quest.restore-grid",
                "label": "恢复能源网格",
                "stages": [
                    {"id": "station.quest-stage.diagnose", "label": "完成诊断"},
                    {"id": "station.quest-stage.reroute", "label": "重定向能源"}
                ]
            }
        ],
        "clocks": [
            {"id": "station.clock.cascade", "label": "级联故障", "segments": 4, "initialValue": 0}
        ],
        "endingConditions": [
            {"endingId": "station.ending.degraded", "clockId": "station.clock.cascade", "minimumClockValue": 4}
        ]
    },
    "behaviors": [
        {"id": "station.behavior.activity-starts-quest", "path": "behaviors/activity-starts-quest.json"},
        {"id": "station.behavior.quest-raises-cascade", "path": "behaviors/quest-raises-threat.json"},
        {"id": "station.behavior.coolant-cycle-supply", "path": "behaviors/timed-supply.json"}
    ],
    "npcs": [
        {
            "id": "station.npc.lyra",
            "entityId": "operator-lyra",
            "displayName": "莱拉",
            "identityPrompt": "你是空间站值班员莱拉。你对 AI 保持专业、克制的信任，只报告自己能观察到的系统变化。",
            "wakeEventTypes": ["worldloom.event.activity-completed", "worldloom.event.travel-completed"],
            "visiblePresentationIds": ["station.presentation.primary-status"],
            "goals": ["阻止级联故障并恢复外环中继"],
            "privateKnowledge": ["你看到过一次未写入公开日志的中继认证失败，但不知道原因。"],
            "capabilities": ["SPEAK", "ACT"],
            "publicActionIds": ["station.npc-action.inspect-console"]
        }
    ],
    "goldenRoutes": [
        {
            "id": "station.route.golden",
            "steps": [
                {
                    "actionId": "station.action.reroute-energy"
                }
            ],
            "expectedEndingId": "station.ending.stable"
        }
    ]
}
