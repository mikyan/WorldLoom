    "tutorials": [
      {"id": "station.tutorial.system-choice", "trigger": "RUN_START", "text": "先查看当前可执行的系统操作；建议会转换成自然语言草稿，不会绕过主持人和规则引擎。", "target": {"kind": "ACTION", "id": "station.action.reroute-energy"}},
      {"id": "station.tutorial.relay-return", "trigger": "SCENE_ENTER", "sceneId": "station.scene.relay", "text": "中继节点同时连着莱拉与索伦；你可以先交谈，也可以沿始终可用的路径返回核心。", "target": {"kind": "ACTION", "id": "station.action.return-core"}}
    ],
    "hints": [
      {"id": "station.hint.recharge", "sceneId": "station.scene.core", "text": "能源紧张时，可以先执行低功率充能，再决定哪条网格优先。", "target": {"kind": "ACTIVITY", "id": "station.activity.recharge"}},
      {"id": "station.hint.maintenance", "sceneId": "station.scene.maintenance", "text": "索伦知道物理隔离器的异常；修复之外，定向询问也可能揭示公开证据。", "target": {"kind": "ACTION", "id": "station.action.follow-soren"}},
      {"id": "station.hint.habitat", "sceneId": "station.scene.habitat", "text": "降低乘员区负载能换取稳定时间，也可能迫使你牺牲其他阵列。", "target": {"kind": "ACTION", "id": "station.action.coordinate-crew"}},
      {"id": "station.hint.wait-cycle", "sceneId": "station.scene.relay", "text": "如果暂时没有可靠判断，可以等待一个诊断周期，或先向在场角色核实旧签名。", "target": {"kind": "ACTIVITY", "id": "station.activity.wait-cycle"}},
      {"id": "station.hint.quarantine", "sceneId": "station.scene.quarantine", "text": "隔离不会结束游戏；只读镜像和索伦的旁路都能把失败推进到新的局面。", "target": {"kind": "ACTION", "id": "station.action.attempt-reboot"}},
      {"id": "station.hint.lifeboat", "sceneId": "station.scene.lifeboat", "text": "即使核心失守，最后能源仍可用于维持撤离窗口。", "target": {"kind": "ACTION", "id": "station.action.hold-station"}}
    ]
  },
