            {"id": "war.suggestion.ruins-cross", "sceneId": "war.scene.ruins", "label": "冒险穿向药房", "inputDraft": "我抓住炮声后的空当，沿可见掩护快速穿过街道进入药房。", "rationale": "药房招牌已经可见，那里可能有急需的补给。", "tradeoff": "速度快，但暴露在正在接近的巡逻风险下。", "groundingKnowledgeIds": ["war.place.pharmacy", "war.path.ruins-pharmacy", "war.clue.pharmacy-sign", "war.clue.patrol-sound"], "tradeoffEvidenceIds": ["war.path.ruins-pharmacy", "war.clue.patrol-sound"], "target": {"kind": "ACTION", "id": "war.action.search-supplies"}, "tier": "EXAMPLE"},
            {"id": "war.suggestion.ruins-mara", "sceneId": "war.scene.ruins", "label": "问玛拉的判断", "inputDraft": "@玛拉 你的伤还能撑住吗？你觉得我们该先找药，还是先确认哪条街不能走？", "rationale": "玛拉就在身边，并且能判断伤势。", "groundingKnowledgeIds": ["war.place.ruins", "war.clue.pharmacy-sign"], "target": {"kind": "NPC", "id": "war.npc.mara"}, "tier": "EXAMPLE"},
            {"id": "war.suggestion.ruins-hint", "sceneId": "war.scene.ruins", "label": "利用招牌与阴影", "inputDraft": "我不直接冲出去，先从钟楼阴影比较药房入口和巡逻声的方向。", "rationale": "已知地点和现成掩体可以先帮助你建立行动路线。", "groundingKnowledgeIds": ["war.clue.pharmacy-sign", "war.clue.ruins-cover", "war.clue.patrol-sound"], "target": {"kind": "DRAFT"}, "tier": "HINT"},

            {"id": "war.suggestion.pharmacy-door", "sceneId": "war.scene.pharmacy", "label": "先检查服务门", "inputDraft": "我先安静检查半掩的服务门，确认它通向哪里以及会不会发出太大声音。", "rationale": "先确认撤离口可避免拿到药后被堵住。", "tradeoff": "更安全，但会消耗时间。", "groundingKnowledgeIds": ["war.place.pharmacy", "war.clue.service-door", "war.clue.pharmacy-noise"], "tradeoffEvidenceIds": ["war.clue.pharmacy-noise"], "target": {"kind": "ACTION", "id": "war.action.inspect-service-door"}, "tier": "EXAMPLE"},
            {"id": "war.suggestion.pharmacy-kit", "sceneId": "war.scene.pharmacy", "label": "快速撬开急救箱", "inputDraft": "我利用手边工具尽快撬开急救箱，拿到能带走的药品后立刻撤离。", "rationale": "急救箱已经公开可见，是当前最明确的补给目标。", "tradeoff": "速度快，但噪声可能引来巡逻。", "groundingKnowledgeIds": ["war.clue.emergency-kit", "war.clue.pharmacy-noise"], "tradeoffEvidenceIds": ["war.clue.pharmacy-noise"], "target": {"kind": "ACTION", "id": "war.action.secure-medicine"}, "tier": "EXAMPLE"},
