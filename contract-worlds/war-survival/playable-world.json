{
    "schema": "worldloom.playable-world/v1",
    "character": {
        "profilePath": "character-profile.json",
        "playerEntityId": "player"
    },
    "initialSceneId": "war.scene.ruins",
    "requiredModuleIds": [
        "worldloom.core.numeric-state",
        "worldloom.rules.random-check",
        "worldloom.rules.world-time",
        "worldloom.rules.activity",
        "worldloom.rules.travel",
        "worldloom.rules.inventory",
        "worldloom.rules.condition",
        "worldloom.rules.relationship",
        "worldloom.rules.quest",
        "worldloom.rules.progress-clock"
    ],
    "scenes": [
        {
            "id": "war.scene.ruins",
            "label": "废墟边缘",
            "actionIds": [
                "war.action.search-supplies"
            ],
            "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.shelter",
            "label": "临时避难所",
            "actionIds": [
                "war.action.signal-convoy"
            ],
            "participantEntityIds": ["npc-mara"]
        },
        {
            "id": "war.scene.under-fire",
            "label": "巡逻队火力下",
            "actionIds": [
                "war.action.escape-patrol"
            ],
            "participantEntityIds": ["npc-tomas"]
        }
    ],
    "actions": [
        {
            "id": "war.action.search-supplies",
            "sceneId": "war.scene.ruins",
            "checkProfileId": "war.check.survive",
            "resolutions": [
                {
                    "outcomeId": "war.outcome.success",
                    "kind": "SUCCESS",
                    "progression": {
                        "nextSceneId": "war.scene.shelter",
                        "objectiveIds": [
                            "war.objective.find-supplies"
                        ]
                    }
                },
                {
                    "outcomeId": "war.outcome.cost",
                    "kind": "COST",
                    "progression": {
                        "nextSceneId": "war.scene.shelter",
                        "objectiveIds": [
                            "war.objective.find-supplies"
                        ]
                    }
                },
                {
                    "outcomeId": "war.outcome.failure",
                    "kind": "FAILURE",
                    "progression": {
                        "nextSceneId": "war.scene.under-fire",
                        "objectiveIds": [
                            "war.objective.escape-danger"
                        ]
                    }
                }
            ]
        },
        {
            "id": "war.action.signal-convoy",
            "sceneId": "war.scene.shelter",
            "checkProfileId": "war.check.survive",
            "resolutions": [
                {
                    "outcomeId": "war.outcome.success",
                    "kind": "SUCCESS",
                    "progression": {
                        "objectiveIds": [
                            "war.objective.reach-convoy"
                        ],
                        "endingId": "war.ending.hopeful"
                    }
                },
                {
                    "outcomeId": "war.outcome.cost",
                    "kind": "COST",
                    "progression": {
                        "objectiveIds": [
                            "war.objective.reach-convoy"
                        ],
                        "endingId": "war.ending.costly"
                    }
                },
                {
                    "outcomeId": "war.outcome.failure",
                    "kind": "FAILURE",
                    "progression": {
                        "endingId": "war.ending.captured"
                    }
                }
            ]
        },
        {
            "id": "war.action.escape-patrol",
            "sceneId": "war.scene.under-fire",
            "checkProfileId": "war.check.survive",
            "resolutions": [
                {
                    "outcomeId": "war.outcome.success",
                    "kind": "SUCCESS",
                    "progression": {
                        "nextSceneId": "war.scene.shelter",
                        "objectiveIds": [
                            "war.objective.escape-danger"
                        ]
                    }
                },
                {
                    "outcomeId": "war.outcome.cost",
                    "kind": "COST",
                    "progression": {
                        "endingId": "war.ending.costly"
                    }
                },
                {
                    "outcomeId": "war.outcome.failure",
                    "kind": "FAILURE",
                    "progression": {
                        "endingId": "war.ending.captured"
                    }
                }
            ]
        }
    ],
    "objectives": [
        {
            "id": "war.objective.find-supplies",
            "label": "找到可用补给",
            "presentationId": "war.presentation.primary-status"
        },
        {
            "id": "war.objective.escape-danger",
            "label": "摆脱巡逻队"
        },
        {
            "id": "war.objective.reach-convoy",
            "label": "与撤离车队会合"
        }
    ],
    "endings": [
        {
            "id": "war.ending.hopeful",
            "label": "带着希望撤离"
        },
        {
            "id": "war.ending.costly",
            "label": "付出代价后幸存"
        },
        {
            "id": "war.ending.captured",
            "label": "落入巡逻队之手"
        }
    ],
    "presentationIds": [
        "war.presentation.primary-status",
        "war.presentation.survival-check"
    ],
    "temporal": {
        "schemaVersion": 1,
        "initialMinute": 480,
        "activities": [
            {
                "id": "war.activity.rest",
                "label": "休息",
                "durationMinutes": 480,
                "availableSceneIds": ["war.scene.shelter"],
                "resolutions": [
                    {
                        "outcomeId": "worldloom.outcome.complete",
                        "effects": [
                            {
                                "entityId": "player",
                                "componentId": "war.vitals",
                                "fieldId": "war.health",
                                "delta": 1
                            }
                        ]
                    },
                    {
                        "outcomeId": "war.outcome.interrupted",
                        "effects": []
                    }
                ],
                "interruption": {
                    "outcomeId": "war.outcome.interrupted",
                    "elapsedMinutes": 60
                }
            },
            {
                "id": "war.activity.search",
                "label": "搜寻",
                "durationMinutes": 120,
                "availableSceneIds": ["war.scene.ruins", "war.scene.shelter"],
                "checkProfileId": "war.check.survive",
                "resolutions": [
                    {"outcomeId": "war.outcome.success", "effects": []},
                    {
                        "outcomeId": "war.outcome.cost",
                        "effects": [
                            {"entityId": "player", "componentId": "war.vitals", "fieldId": "war.health", "delta": -1}
                        ]
                    },
                    {
                        "outcomeId": "war.outcome.failure",
                        "effects": [
                            {"entityId": "player", "componentId": "war.vitals", "fieldId": "war.health", "delta": -2}
                        ]
                    },
                    {
                        "outcomeId": "war.outcome.interrupted",
                        "effects": []
                    }
                ],
                "interruption": {
                    "outcomeId": "war.outcome.interrupted",
                    "elapsedMinutes": 30
                }
            },
            {
                "id": "war.activity.treat",
                "label": "治疗",
                "durationMinutes": 60,
                "availableSceneIds": ["war.scene.shelter"],
                "resolutions": [
                    {
                        "outcomeId": "worldloom.outcome.complete",
                        "effects": [
                            {"entityId": "player", "componentId": "war.vitals", "fieldId": "war.health", "delta": 1}
                        ]
                    }
                ]
            }
        ],
        "routes": [
            {
                "id": "war.travel.ruins-to-shelter",
                "label": "前往临时避难所",
                "fromSceneId": "war.scene.ruins",
                "toSceneId": "war.scene.shelter",
                "durationMinutes": 90,
                "checkProfileId": "war.check.survive",
                "resolutions": [
                    {"outcomeId": "war.outcome.success", "arrives": true},
                    {"outcomeId": "war.outcome.cost", "arrives": true, "additionalDurationMinutes": 30},
                    {"outcomeId": "war.outcome.failure", "arrives": false, "additionalDurationMinutes": 60}
                ]
            },
            {
                "id": "war.travel.shelter-to-ruins",
                "label": "返回废墟边缘",
                "fromSceneId": "war.scene.shelter",
                "toSceneId": "war.scene.ruins",
                "durationMinutes": 90,
                "resolutions": [
                    {"outcomeId": "worldloom.outcome.complete", "arrives": true}
                ]
            },
            {
                "id": "war.travel.fire-to-ruins",
                "label": "撤回废墟边缘",
                "fromSceneId": "war.scene.under-fire",
                "toSceneId": "war.scene.ruins",
                "durationMinutes": 45,
                "resolutions": [
                    {"outcomeId": "worldloom.outcome.complete", "arrives": true}
                ]
            }
        ],
        "scheduledTriggers": [
            {
                "id": "war.trigger.nightfall",
                "label": "夜幕降临",
                "atMinute": 600,
                "effects": [
                    {"entityId": "player", "componentId": "war.vitals", "fieldId": "war.health", "delta": -1}
                ]
            }
        ]
    },
    "adventureState": {
        "schemaVersion": 1,
        "items": [
            {"id": "war.item.bread", "label": "干面包", "unitWeight": 1},
            {"id": "war.item.bandage", "label": "绷带", "unitWeight": 1}
        ],
        "inventory": {
            "ownerEntityId": "player",
            "capacity": 10,
            "initialStacks": [
                {"itemId": "war.item.bread", "quantity": 2},
                {"itemId": "war.item.bandage", "quantity": 1}
            ]
        },
        "conditions": [
            {"id": "war.condition.exhausted", "label": "精疲力竭", "maximumStacks": 3, "durationMinutes": 480},
            {"id": "war.condition.wounded", "label": "负伤", "maximumStacks": 3, "visibility": "PUBLIC"}
        ],
        "relationships": [
            {
                "id": "war.relationship.mara-trust",
                "label": "玛拉的信任",
                "sourceEntityId": "npc-mara",
                "targetEntityId": "player",
                "minimum": -3,
                "maximum": 3,
                "initialValue": 0,
                "visibility": "PLAYER"
            }
        ],
        "quests": [
            {
                "id": "war.quest.survive",
                "label": "活到撤离",
                "stages": [
                    {"id": "war.quest-stage.find-supplies", "label": "寻找补给"},
                    {"id": "war.quest-stage.reach-convoy", "label": "抵达撤离车队"}
                ]
            }
        ],
        "clocks": [
            {"id": "war.clock.patrol-threat", "label": "巡逻队威胁", "segments": 6, "initialValue": 1}
        ],
        "endingConditions": [
            {"endingId": "war.ending.hopeful", "completedQuestId": "war.quest.survive"}
        ]
    },
    "behaviors": [
        {"id": "war.behavior.activity-starts-quest", "path": "behaviors/activity-starts-quest.json"},
        {"id": "war.behavior.quest-raises-threat", "path": "behaviors/quest-raises-threat.json"},
        {"id": "war.behavior.nightfall-supply", "path": "behaviors/timed-supply.json"}
    ],
    "npcs": [
        {
            "id": "war.npc.mara",
            "entityId": "npc-mara",
            "displayName": "玛拉",
            "identityPrompt": "你是玛拉，一名谨慎但愿意保护孩子的战地医护员。保持简短、具体，不替玩家决定行动。",
            "wakeEventTypes": ["worldloom.event.activity-completed", "worldloom.event.travel-completed"],
            "visiblePresentationIds": ["war.presentation.primary-status"],
            "goals": ["帮助队伍避开巡逻并找到安全补给"],
            "privateKnowledge": ["你怀疑北侧道路已经被巡逻队封锁，但尚未亲眼确认。"],
            "capabilities": ["SPEAK", "ACT"],
            "publicActionIds": ["war.npc-action.check-wounds"]
        },
        {
            "id": "war.npc.tomas",
            "entityId": "npc-tomas",
            "displayName": "托马斯",
            "identityPrompt": "你是托马斯，熟悉废墟道路的少年信使。只根据当前感知回应，不泄露未确认的路线情报。",
            "wakeEventTypes": ["worldloom.event.activity-completed", "worldloom.event.travel-completed"],
            "goals": ["找到能绕开交火区的路线"],
            "privateKnowledge": ["你在旧水塔下藏了一张残缺地图，这件事还没有告诉玛拉。"],
            "capabilities": ["SPEAK", "ACT"],
            "publicActionIds": ["war.npc-action.scout-cover"]
        }
    ],
    "goldenRoutes": [
        {
            "id": "war.route.golden",
            "steps": [
                {
                    "actionId": "war.action.search-supplies",
                    "randomValues": [
                        6,
                        6
                    ]
                },
                {
                    "actionId": "war.action.signal-convoy",
                    "randomValues": [
                        6,
                        6
                    ]
                }
            ],
            "expectedEndingId": "war.ending.hopeful"
        },
        {
            "id": "war.route.costly",
            "steps": [
                {
                    "actionId": "war.action.search-supplies",
                    "randomValues": [
                        3,
                        4
                    ]
                },
                {
                    "actionId": "war.action.signal-convoy",
                    "randomValues": [
                        3,
                        4
                    ]
                }
            ],
            "expectedEndingId": "war.ending.costly"
        },
        {
            "id": "war.route.failure",
            "steps": [
                {
                    "actionId": "war.action.search-supplies",
                    "randomValues": [
                        1,
                        1
                    ]
                },
                {
                    "actionId": "war.action.escape-patrol",
                    "randomValues": [
                        1,
                        1
                    ]
                }
            ],
            "expectedEndingId": "war.ending.captured"
        }
    ]
}
