    "scenes": [
        {
            "id": "war.scene.ruins", "label": "钟楼废墟",
            "description": "上午八点，炮声刚停。钟楼对街一块裂开的绿色十字招牌标出被洗劫的药房，向东的旧路牌仍指着水塔。玛拉手臂渗血，托马斯正盯着北街；履带声正在废墟后逼近。你们要在巡逻队转回来前找到药品和下一条安全路线。",
            "backgroundAssetId": "worldloom.background.war-ruins",
            "actionIds": ["war.action.observe-street", "war.action.search-supplies"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.pharmacy", "label": "被洗劫的药房",
            "description": "碎玻璃铺满地面，翻倒药柜后露出一只上锁的急救箱，后墙还有半掩的服务门。玛拉能辨认药品，但街口车辆怠速声越来越近；撬锁会快却可能制造噪声，先检查柜台和后门更稳妥却会耗时。",
            "actionIds": ["war.action.inspect-service-door", "war.action.secure-medicine"], "participantEntityIds": ["npc-mara"]
        },
        {
            "id": "war.scene.under-fire", "label": "巡逻队火力下",
            "description": "北街亮起枪口火光，翻倒的电车挡住第一轮射击。托马斯在车轮后发现通往排水渠的破口；左侧烟尘能遮住视线，但绕过去会多花时间。药房已无法安全靠近。",
            "actionIds": ["war.action.escape-patrol"], "participantEntityIds": ["npc-tomas"]
        },
        {
            "id": "war.scene.drainage", "label": "旧排水渠岔口",
            "description": "潮湿渠洞分成两条：左侧白布条通向学校避难所，右侧锈管延伸到旧水塔方向。玛拉想先照顾避难所伤员，托马斯坚持水塔里的旧地图可能帮大家绕路；两边都各有筹码和未知风险。",
            "actionIds": ["war.action.follow-mara", "war.action.follow-tomas"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.shelter", "label": "学校地下避难所",
            "description": "地下室里挤着伤员和孩子。守门人愿意分享车队频率，但前提是你们先帮忙稳住混乱。",
            "actionIds": ["war.action.aid-shelter"], "participantEntityIds": ["npc-mara"]
        },
        {
            "id": "war.scene.water-tower", "label": "旧水塔",
            "description": "锈蚀楼梯在风里摇晃。托马斯藏的地图仍压在检修盒里，但附近已经留下新鲜脚印。",
            "actionIds": ["war.action.recover-map"], "participantEntityIds": ["npc-tomas"]
        },
        {
            "id": "war.scene.ration-line", "label": "废弃配给站",
            "description": "几名饥饿的幸存者守着最后一箱罐头。你可以交换情报，也可能被迫放弃一部分补给换取通行。",
            "actionIds": ["war.action.bargain-passage"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.checkpoint", "label": "河堤检查站",
            "description": "检查站横在通往车队的最后一公里。可以拿避难所的名单冒险交涉，也可以沿托马斯地图标出的涵洞潜行。",
            "actionIds": ["war.action.present-papers", "war.action.use-culvert"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.detention", "label": "临时拘留棚",
            "description": "你们被分在铁丝网后的角落。换岗前只有一次机会：制造混乱，从破损围栏钻出去。",
            "actionIds": ["war.action.escape-detention"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        },
        {
            "id": "war.scene.convoy", "label": "撤离车队外缘",
            "description": "发动机声就在雾里。巡逻队也在逼近，你必须让车队认出避难所频率，并在最后几分钟决定谁先上车。",
            "actionIds": ["war.action.signal-convoy"], "participantEntityIds": ["npc-mara", "npc-tomas"]
        }
    ],
